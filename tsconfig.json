{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "apps/execution-daemon/**/*.ts",
    "apps/knowledge-merge-worker/**/*.ts",
    "apps/room-session-host/**/*.ts",
    "tests/**/*.ts",
    "next.config.ts",
    "playwright*.ts",
    "prisma.config.ts",
    "vite.execution-daemon.config.mts",
    "vite.knowledge-merge-worker.config.mts",
    "vite.room-backend-test.config.mts",
    "vite.room-session-host.config.mts",
    "vite.room-tool-confirmation-test.config.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".tmp/iteration-regression/next-dist/types/**/*.ts",
    ".tmp/iteration-regression/next-dist/dev/types/**/*.ts",
    ".tmp/chat-guidelines-iteration/next-dist/types/**/*.ts",
    ".tmp/chat-guidelines-iteration/next-dist/dev/types/**/*.ts",
    "../../../../tmp/chat-guidelines-iteration-3298/next-dist/types/**/*.ts",
    "../../../../tmp/chat-guidelines-iteration-3298/next-dist/dev/types/**/*.ts",
    ".tmp/chat-guidelines-iteration-3301/next-dist/types/**/*.ts",
    ".tmp/chat-guidelines-iteration-3301/next-dist/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
