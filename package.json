{
  "name": "chengxing",
  "productName": "成形",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "description": "AI-native authoring workspace",
  "author": "Chengxing",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:bootstrap:local": "node scripts/bootstrap-local-db.mjs",
    "dev": "next dev --webpack",
    "predev": "npm run db:generate && npm run db:bootstrap:local",
    "prebuild": "npm run db:generate",
    "build": "next build --webpack",
    "postinstall": "npm run db:generate",
    "prepare": "husky",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.tmp/playwright-browsers npx playwright install chromium",
    "test:e2e:iteration": "npx playwright test --config=playwright.config.ts",
    "test:browser:preflight": "node scripts/browser-preflight.mjs",
    "test:control-plane": "node scripts/test-control-plane.mjs",
    "test:control-plane:inventory": "node scripts/test-control-plane.mjs --inventory-only",
    "test:ai-inspector": "node scripts/test-ai-inspector.mjs",
    "verify:iteration:static": "node scripts/verify-iteration-static.mjs",
    "verify:iteration": "node scripts/verify-iteration.mjs",
    "execution:daemon:build": "vite build --config vite.execution-daemon.config.mts",
    "execution:daemon:start": "node .vite/execution-daemon/index.mjs",
    "execution:daemon:test": "npm run execution:daemon:build && playwright test --config=apps/execution-daemon/src/playwright.config.ts",
    "knowledge:merge-worker:build": "vite build --config vite.knowledge-merge-worker.config.mts",
    "knowledge:merge-worker:start": "node .vite/knowledge-merge-worker/index.mjs",
    "knowledge:merge-worker:test": "npm run knowledge:merge-worker:build && playwright test --config=apps/knowledge-merge-worker/src/playwright.config.ts",
    "room:host:build": "vite build --config vite.room-session-host.config.mts",
    "room:host:start": "node .vite/room-session-host/index.mjs",
    "room:host:test": "npm run room:host:build && playwright test --config=apps/room-session-host/src/playwright.config.ts",
    "start": "next start",
    "lint": "eslint",
    "auth:openai-oauth": "node scripts/openai-oauth-login.mjs"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.21",
    "@earendil-works/pi-agent-core": "^0.84.3",
    "@earendil-works/pi-ai": "^0.84.3",
    "@emoji-mart/data": "^1.2.1",
    "@libsql/client": "0.17.4",
    "@platejs/basic-nodes": "^52.0.11",
    "@platejs/code-block": "^52.0.11",
    "@platejs/combobox": "^52.0.15",
    "@platejs/comment": "^52.0.11",
    "@platejs/core": "^53.3.7",
    "@platejs/date": "^52.0.11",
    "@platejs/dnd": "^52.0.11",
    "@platejs/emoji": "^52.0.15",
    "@platejs/indent": "^52.0.11",
    "@platejs/link": "^52.0.11",
    "@platejs/list": "^52.0.11",
    "@platejs/mention": "^52.0.15",
    "@platejs/suggestion": "^52.0.11",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-toolbar": "^1.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.2",
    "platejs": "^52.3.2",
    "prisma": "^7.9.1",
    "proper-lockfile": "4.1.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "remark-parse": "^11.0.0",
    "remark-slate": "^1.8.6",
    "tailwind-merge": "^3.5.0",
    "tldraw": "^4.5.12",
    "typebox": "1.3.7",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@next/swc-wasm-nodejs": "16.3.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "husky": "^9.1.7",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "msw@2.12.10": true,
    "prisma@7.9.1": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.11.1": true
  }
}
