{
  "name": "chengxing",
  "productName": "成形",
  "version": "0.1.0",
  "private": true,
  "main": ".vite/build/main.js",
  "description": "AI-native authoring workspace",
  "author": "Chengxing",
  "scripts": {
    "db:bootstrap:local": "node scripts/bootstrap-local-db.mjs",
    "dev": "next dev",
    "predev": "npm run db:bootstrap:local",
    "build": "next build --webpack",
    "prepare": "husky",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.tmp/playwright-browsers npx playwright install chromium",
    "test:e2e:iteration": "npx playwright test --config=playwright.config.ts",
    "test:ai-inspector": "node scripts/test-ai-inspector.mjs",
    "verify:iteration:static": "node scripts/verify-iteration-static.mjs",
    "verify:iteration": "node scripts/verify-iteration.mjs",
    "desktop:dev": "electron-forge start",
    "desktop:package": "npm run build && electron-forge package",
    "desktop:make": "npm run build && electron-forge make",
    "desktop:make:dmg": "npm run build && DAO_ENABLE_DMG=1 electron-forge make --platform=darwin",
    "desktop:notarize": "npm run build && DAO_ENABLE_DMG=1 electron-forge make --platform=darwin",
    "desktop:oauth:backup": "node apps/desktop/scripts/oauth-backup-restore.mjs backup",
    "desktop:oauth:restore": "node apps/desktop/scripts/oauth-backup-restore.mjs restore",
    "desktop:reset-data": "node apps/desktop/scripts/reset-app-data.mjs",
    "desktop:smoke:packaged": "npm run desktop:package && node apps/desktop/scripts/smoke-packaged.mjs",
    "desktop:start": "electron-forge start",
    "start": "next start",
    "lint": "eslint",
    "auth:openai-oauth": "node scripts/openai-oauth-login.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.55",
    "@ai-sdk/openai": "^3.0.39",
    "@ariakit/react": "^0.4.21",
    "@emoji-mart/data": "^1.2.1",
    "@libsql/client": "^0.17.0",
    "@mariozechner/pi-agent-core": "^0.57.1",
    "@mariozechner/pi-ai": "^0.57.1",
    "@platejs/basic-nodes": "^52.0.11",
    "@platejs/code-block": "^52.0.11",
    "@platejs/combobox": "^52.0.15",
    "@platejs/comment": "^52.0.11",
    "@platejs/core": "^52.0.17",
    "@platejs/date": "^52.0.11",
    "@platejs/dnd": "^52.0.11",
    "@platejs/emoji": "^52.0.15",
    "@platejs/indent": "^52.0.11",
    "@platejs/link": "^52.0.11",
    "@platejs/list": "^52.0.11",
    "@platejs/mention": "^52.0.15",
    "@platejs/suggestion": "^52.0.11",
    "@prisma/adapter-libsql": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@sinclair/typebox": "^0.34.48",
    "ai": "^6.0.112",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "platejs": "^52.3.2",
    "prisma": "^7.4.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-router-dom": "^6.30.1",
    "remark-parse": "^11.0.0",
    "remark-slate": "^1.8.6",
    "tailwind-merge": "^3.5.0",
    "tldraw": "^4.5.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "appdmg": "^0.6.6",
    "dotenv": "^17.3.1",
    "electron": "^40.8.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.1.8"
  }
}
