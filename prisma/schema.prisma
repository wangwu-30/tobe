generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id                         String                        @id
  slug                       String                        @unique
  name                       String
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  memberships                OrganizationMembership[]
  subscription               Subscription?
  devices                    Device[]
  sessions                   Session[]
  messages                   ChatMessage[]
  documents                  Document[]
  workspaceFiles             WorkspaceFile[]
  versions                   Version[]
  labels                     Label[]
  commentThreads             CommentThread[]
  commentMessages            CommentMessage[]
  notes                      Note[]
  workflowPlaybooks          WorkflowPlaybook[]
  wikiEditLocks              WikiEditLock[]
  workspaceRuns              WorkspaceRun[]
  assistantRuns              AssistantRun[]
  workspacePlans             WorkspacePlan[]
  projectFolders             ProjectFolder[]
  projectMounts              ProjectMount[]
  nodeRelations              NodeRelation[]
  projectCanvasLayouts       ProjectCanvasLayout[]
  mutationRequests           MutationRequest[]
  stagedChangeSets           StagedChangeSet[]
  chatAttachments            ChatAttachment[]
  syncEvents                 SyncEvent[]
  syncCursors                SyncCursor[]
  agentProfiles              AgentProfile[]
  teamTasks                  TeamTask[]
  taskActivities             TaskActivity[]
  executionRuntimes          ExecutionRuntime[]
  executionJobs              ExecutionJob[]
  executionAttempts          ExecutionAttempt[]
  executionEvents            ExecutionEvent[]
  executionArtifacts         ExecutionArtifact[]
  executionInputRequests     ExecutionInputRequest[]
  executionRecoveryIncidents ExecutionRecoveryIncident[]
  executionOutbox            ExecutionOutbox[]
  knowledgeSpaces            KnowledgeSpace[]
  knowledgeBindings          KnowledgeBinding[]
  knowledgeSnapshots         KnowledgeSnapshot[]
  knowledgeChanges           KnowledgeChangeRequest[]
  knowledgeMergeOperations   KnowledgeMergeOperation[]
  rooms                      Room[]
  roomMessages               RoomMessage[]
  roomMentions               RoomMention[]
  roomAgentSessions          RoomAgentSession[]
  roomInboxDeliveries        RoomInboxDelivery[]
  roomEvents                 RoomEvent[]
  roomOutbox                 RoomOutbox[]
  roomDelegationGrants       RoomDelegationGrant[]
  roomDelegationInvocations  RoomDelegationInvocation[]
  roomDelegationRootBudgets  RoomDelegationRootBudget[]
  roomToolConfirmations      RoomToolConfirmationRequest[]
  roomContextSummaries       RoomContextSummaryCache[]
}

model User {
  id                             String                        @id
  name                           String
  email                          String?                       @unique
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  memberships                    OrganizationMembership[]
  devices                        Device[]
  requestedRoomToolConfirmations RoomToolConfirmationRequest[] @relation("RoomToolConfirmationRequestedBy")
  approvedRoomToolConfirmations  RoomToolConfirmationRequest[] @relation("RoomToolConfirmationApprovedBy")
  rejectedRoomToolConfirmations  RoomToolConfirmationRequest[] @relation("RoomToolConfirmationRejectedBy")
  reviewedStagedChangeSets       StagedChangeSet[]             @relation("StagedChangeSetReviewer")
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("owner")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  plan           String       @default("local")
  status         String       @default("inactive")
  cloudEnabled   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Device {
  id             String       @id
  organizationId String
  userId         String
  label          String
  type           String       @default("local")
  lastSeenAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncCursors    SyncCursor[]
}

model Session {
  id                  String           @id @default(cuid())
  organizationId      String           @default("local-org")
  scopeKind           String           @default("wiki")
  title               String           @default("New Conversation")
  wikiId              String?
  projectId           String?
  parentSessionId     String?
  forkedFromMessageId String?
  baseVersionId       String?
  activeFileId        String?
  createdByUserId     String?
  originDeviceId      String?
  sourceType          String           @default("chat")
  revision            Int              @default(1)
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wiki                Document?        @relation("WikiConversations", fields: [wikiId], references: [id], onDelete: SetNull)
  project             Document?        @relation("ProjectScopedConversations", fields: [projectId], references: [id], onDelete: SetNull)
  parentSession       Session?         @relation("ConversationBranches", fields: [parentSessionId], references: [id], onDelete: SetNull)
  childSessions       Session[]        @relation("ConversationBranches")
  forkedFromMessage   ChatMessage?     @relation("ConversationForkMessage", fields: [forkedFromMessageId], references: [id], onDelete: SetNull)
  baseVersion         Version?         @relation("ConversationBaseVersion", fields: [baseVersionId], references: [id], onDelete: SetNull)
  activeFile          WorkspaceFile?   @relation("ConversationActiveFile", fields: [activeFileId], references: [id], onDelete: SetNull)
  messages            ChatMessage[]
  assistantRuns       AssistantRun[]
  chatAttachments     ChatAttachment[]
  documents           Document[]       @relation("PrimaryConversationDocuments")
  sourceVersions      Version[]        @relation("SnapshotSourceConversation")

  @@index([organizationId, updatedAt])
  @@index([organizationId, scopeKind, updatedAt])
  @@index([wikiId, updatedAt])
  @@index([projectId, updatedAt])
  @@index([parentSessionId, updatedAt])
}

model ChatMessage {
  id                  String           @id @default(cuid())
  organizationId      String           @default("local-org")
  sessionId           String
  role                String
  content             String
  documentId          String?
  focusNodeId         String?
  model               String?
  createdByUserId     String?
  originDeviceId      String?
  revision            Int              @default(1)
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session             Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  document            Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  focusNode           Document?        @relation("ConversationMessageFocusNode", fields: [focusNodeId], references: [id], onDelete: SetNull)
  forkedConversations Session[]        @relation("ConversationForkMessage")
  sourceSnapshots     Version[]        @relation("SnapshotSourceMessage")
  requestedRuns       AssistantRun[]   @relation("ConversationRequestRuns")
  attachments         ChatAttachment[]

  @@index([organizationId, createdAt])
  @@index([sessionId, createdAt])
  @@index([focusNodeId, createdAt])
}

model Document {
  id                     String                @id @default(cuid())
  organizationId         String                @default("local-org")
  sessionId              String
  projectId              String?
  projectFolderId        String?
  draftBaseVersionId     String?
  projectTitle           String?
  parentDocumentId       String?
  treeSortOrder          Float                 @default(0)
  title                  String                @default("Untitled")
  content                String                @default("[]")
  projectRootPath        String?
  canvasMetaJson         String?
  status                 String                @default("draft")
  currentVersion         Int                   @default(0)
  draftRevision          Int                   @default(0)
  createdByUserId        String?
  originDeviceId         String?
  revision               Int                   @default(1)
  deletedAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session                Session               @relation("PrimaryConversationDocuments", fields: [sessionId], references: [id], onDelete: Cascade)
  draftBaseVersion       Version?              @relation("DocumentDraftBaseVersion", fields: [draftBaseVersionId], references: [id], onDelete: SetNull)
  conversations          Session[]             @relation("WikiConversations")
  projectConversations   Session[]             @relation("ProjectScopedConversations")
  sourceProjectMounts    ProjectMount[]        @relation("ProjectMountSource")
  targetProjectMounts    ProjectMount[]        @relation("ProjectMountTarget")
  sourceNodeRelations    NodeRelation[]        @relation("NodeRelationSource")
  targetNodeRelations    NodeRelation[]        @relation("NodeRelationTarget")
  projectCanvasPositions ProjectCanvasLayout[] @relation("ProjectCanvasPosition")
  chatMessages           ChatMessage[]
  focusedMessages        ChatMessage[]         @relation("ConversationMessageFocusNode")
  files                  WorkspaceFile[]
  versions               Version[]
  threads                CommentThread[]
  workflowPlaybooks      WorkflowPlaybook[]    @relation("WorkflowPlaybookDocument")
  wikiEditLock           WikiEditLock?
  workspaceRuns          WorkspaceRun[]
  assistantRuns          AssistantRun[]
  workspacePlan          WorkspacePlan?
  stagedChangeSets       StagedChangeSet[]
  chatAttachments        ChatAttachment[]

  @@index([organizationId, updatedAt])
  @@index([sessionId, updatedAt])
  @@index([draftBaseVersionId])
  @@index([organizationId, projectId, projectFolderId, updatedAt])
}

model ProjectFolder {
  id              String       @id @default(cuid())
  organizationId  String       @default("local-org")
  projectId       String
  parentId        String?
  treeSortOrder   Float        @default(0)
  title           String
  createdByUserId String?
  originDeviceId  String?
  revision        Int          @default(1)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, updatedAt])
}

model ProjectMount {
  id              String       @id @default(cuid())
  organizationId  String       @default("local-org")
  sourceProjectId String
  targetProjectId String
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceProject   Document     @relation("ProjectMountSource", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  targetProject   Document     @relation("ProjectMountTarget", fields: [targetProjectId], references: [id], onDelete: Cascade)

  @@unique([sourceProjectId, targetProjectId])
  @@index([organizationId, sourceProjectId])
  @@index([organizationId, targetProjectId])
}

model NodeRelation {
  id             String       @id @default(cuid())
  organizationId String       @default("local-org")
  sourceNodeId   String
  targetNodeId   String
  kind           String       @default("dependency")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceNode     Document     @relation("NodeRelationSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode     Document     @relation("NodeRelationTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, kind])
  @@index([organizationId, sourceNodeId])
  @@index([organizationId, targetNodeId])
}

model ProjectCanvasLayout {
  id             String       @id @default(cuid())
  organizationId String       @default("local-org")
  projectId      String
  x              Float        @default(0)
  y              Float        @default(0)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Document     @relation("ProjectCanvasPosition", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectId])
}

model Version {
  id                                String             @id @default(cuid())
  organizationId                    String             @default("local-org")
  documentId                        String
  versionNum                        Int
  content                           String
  title                             String
  parentVersionId                   String?
  sourceSessionId                   String?
  sourceMessageId                   String?
  /// @deprecated Legacy read-compat field. Runtime write/query semantics now derive from `Label`.
  versionType                       String             @default("manual")
  lockedAt                          DateTime           @default(now())
  createdByUserId                   String?
  originDeviceId                    String?
  revision                          Int                @default(1)
  deletedAt                         DateTime?
  organization                      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document                          Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentVersion                     Version?           @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions                     Version[]          @relation("VersionLineage")
  sourceConversation                Session?           @relation("SnapshotSourceConversation", fields: [sourceSessionId], references: [id], onDelete: SetNull)
  sourceMessage                     ChatMessage?       @relation("SnapshotSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  baseConversations                 Session[]          @relation("ConversationBaseVersion")
  draftBaseDocuments                Document[]         @relation("DocumentDraftBaseVersion")
  baseStagedChangeSets              StagedChangeSet[]  @relation("StagedChangeSetBaseVersion")
  appliedCheckpointStagedChangeSets StagedChangeSet[]  @relation("StagedChangeSetAppliedCheckpoint")
  labels                            Label[]
  threads                           CommentThread[]
  workflowPlaybooks                 WorkflowPlaybook[] @relation("WorkflowPlaybookSourceVersion")
  workspaceRuns                     WorkspaceRun[]

  @@unique([documentId, versionNum])
  @@index([organizationId, lockedAt])
}

model Label {
  id              String       @id @default(cuid())
  organizationId  String       @default("local-org")
  versionId       String
  kind            String
  name            String
  createdByUserId String?
  originDeviceId  String?
  revision        Int          @default(1)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version         Version      @relation(fields: [versionId], references: [id], onDelete: Cascade)

  /// Active aligned-label uniqueness is enforced by a SQLite partial unique
  /// index in migrations because Prisma schema indexes cannot express the
  /// deletedAt/kind predicate.
  @@index([organizationId, createdAt])
  @@index([versionId, createdAt])
}

model WorkspaceFile {
  id                  String           @id @default(cuid())
  organizationId      String           @default("local-org")
  documentId          String
  parentId            String?
  name                String
  type                String           @default("file")
  kind                String           @default("richtext")
  role                String           @default("deliverable")
  path                String
  language            String?
  content             String           @default("")
  isPrimary           Boolean          @default(false)
  sortOrder           Int              @default(0)
  createdByUserId     String?
  originDeviceId      String?
  revision            Int              @default(1)
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document            Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent              WorkspaceFile?   @relation("WorkspaceFileChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children            WorkspaceFile[]  @relation("WorkspaceFileChildren")
  activeConversations Session[]        @relation("ConversationActiveFile")
  commentThreads      CommentThread[]
  chatAttachments     ChatAttachment[]

  @@unique([documentId, path])
  @@index([organizationId, updatedAt])
  @@index([documentId, parentId, sortOrder])
}

model CommentThread {
  id                String             @id @default(cuid())
  organizationId    String             @default("local-org")
  documentId        String
  fileId            String?
  versionId         String?
  anchorText        String
  selectionAnchor   String?
  agentBindingsJson String?
  researchStateJson String?
  draftRevision     Int?
  status            String             @default("open")
  resolvedAt        DateTime?
  createdByUserId   String?
  originDeviceId    String?
  revision          Int                @default(1)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document          Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  file              WorkspaceFile?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  version           Version?           @relation(fields: [versionId], references: [id], onDelete: SetNull)
  messages          CommentMessage[]
  workflowPlaybooks WorkflowPlaybook[] @relation("WorkflowPlaybookSourceThread")

  @@index([organizationId, updatedAt])
  @@index([documentId, updatedAt])
  @@index([fileId, updatedAt])
}

model CommentMessage {
  id                  String        @id @default(cuid())
  organizationId      String        @default("local-org")
  threadId            String
  role                String
  content             String
  model               String?
  mentionedAgentsJson String?
  agentId             String?
  agentLabel          String?
  createdByUserId     String?
  originDeviceId      String?
  revision            Int           @default(1)
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread              CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([threadId, createdAt])
}

model Note {
  id              String       @id @default(cuid())
  organizationId  String       @default("local-org")
  scope           String
  scopeId         String
  kind            String       @default("knowledge")
  title           String?
  content         String
  source          String       @default("manual")
  sourceRef       String?
  active          Boolean      @default(true)
  createdByUserId String?
  originDeviceId  String?
  revision        Int          @default(1)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, scope, scopeId, createdAt])
}

model WorkflowPlaybook {
  id                   String          @id @default(cuid())
  organizationId       String          @default("local-org")
  documentId           String?
  sourceVersionId      String?
  sourceThreadId       String?
  title                String
  status               String          @default("draft")
  summary              String          @default("")
  steps                String          @default("")
  constraints          String          @default("")
  checklist            String          @default("")
  extensionHints       String          @default("[]")
  content              String          @default("")
  archivedAt           DateTime?
  createdByUserId      String?
  originDeviceId       String?
  revision             Int             @default(1)
  deletedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document             Document?       @relation("WorkflowPlaybookDocument", fields: [documentId], references: [id], onDelete: SetNull)
  sourceVersion        Version?        @relation("WorkflowPlaybookSourceVersion", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  sourceThread         CommentThread?  @relation("WorkflowPlaybookSourceThread", fields: [sourceThreadId], references: [id], onDelete: SetNull)
  activeWorkspacePlans WorkspacePlan[] @relation("WorkspacePlanActiveWorkflow")

  @@index([organizationId, createdAt])
  @@index([documentId, createdAt])
  @@index([sourceVersionId, createdAt])
}

model WikiEditLock {
  id              String       @id @default(cuid())
  organizationId  String
  documentId      String       @unique
  userId          String
  originDeviceId  String
  lockedVersionId String?
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document        Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
}

model WorkspaceRun {
  id              String       @id @default(cuid())
  organizationId  String
  documentId      String
  versionId       String?
  kind            String
  command         String
  status          String       @default("pending")
  previewUrl      String?
  logPath         String?
  exitCode        Int?
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  createdByUserId String?
  originDeviceId  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document        Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version         Version?     @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
  @@index([documentId, startedAt])
  @@index([status, startedAt])
}

model AssistantRun {
  id               String       @id @default(cuid())
  organizationId   String       @default("local-org")
  sessionId        String
  documentId       String?
  scopeKind        String       @default("wiki")
  requestMessageId String?
  mode             String       @default("revision")
  title            String
  status           String       @default("queued")
  summary          String?
  payloadJson      String?
  createdByUserId  String?
  originDeviceId   String?
  revision         Int          @default(1)
  deletedAt        DateTime?
  startedAt        DateTime     @default(now())
  finishedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session          Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  document         Document?    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestMessage   ChatMessage? @relation("ConversationRequestRuns", fields: [requestMessageId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
  @@index([organizationId, scopeKind, startedAt])
  @@index([sessionId, startedAt])
  @@index([documentId, startedAt])
  @@index([status, startedAt])
}

model ChatAttachment {
  id              String        @id @default(cuid())
  organizationId  String        @default("local-org")
  sessionId       String
  messageId       String
  documentId      String
  fileId          String
  kind            String
  source          String        @default("upload")
  storageFormat   String        @default("text")
  mimeType        String?
  originalName    String
  sizeBytes       Int?
  createdByUserId String?
  originDeviceId  String?
  revision        Int           @default(1)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message         ChatMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  file            WorkspaceFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([sessionId, createdAt])
  @@index([messageId, createdAt])
  @@index([documentId, createdAt])
}

model WorkspacePlan {
  id                       String            @id @default(cuid())
  organizationId           String
  documentId               String            @unique
  activeWorkflowPlaybookId String?
  goal                     String
  deliverableType          String            @default("document")
  constraints              String?
  styleGuide               String?
  status                   String            @default("drafting")
  version                  Int               @default(1)
  stagesJson               String
  activeStageId            String?
  lastProgressNote         String?
  createdByUserId          String?
  originDeviceId           String?
  revision                 Int               @default(1)
  deletedAt                DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document                 Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  activeWorkflowPlaybook   WorkflowPlaybook? @relation("WorkspacePlanActiveWorkflow", fields: [activeWorkflowPlaybookId], references: [id], onDelete: SetNull)

  @@index([organizationId, updatedAt])
  @@index([documentId, updatedAt])
  @@index([activeWorkflowPlaybookId, updatedAt])
}

model MutationRequest {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  operation      String
  requestKey     String
  requestHash    String
  status         String       @default("in_progress")
  responseJson   String?
  resourceType   String?
  resourceId     String?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, operation, requestKey])
  @@index([organizationId, userId, operation, status, updatedAt])
  @@index([organizationId, createdAt])
}

model StagedChangeSet {
  id                         String       @id @default(cuid())
  organizationId             String
  documentId                 String
  sessionId                  String?
  baseVersionId              String?
  baseVersionSha256          String?
  baseDraftRevision          Int?
  patchSchemaVersion         Int?
  patchSha256                String?
  appliedCheckpointVersionId String?
  title                      String
  summary                    String
  status                     String       @default("pending")
  sourceType                 String       @default("ai")
  changesJson                String
  createdByUserId            String?
  originDeviceId             String?
  appliedAt                  DateTime?
  discardedAt                DateTime?
  reviewedByUserId           String?
  reviewedAt                 DateTime?
  revision                   Int          @default(1)
  deletedAt                  DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document                   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  baseVersion                Version?     @relation("StagedChangeSetBaseVersion", fields: [baseVersionId], references: [id], onDelete: SetNull)
