  id             String       @id
  organizationId String
  entityType     String
  entityId       String
  actorUserId    String
  originDeviceId String?
  revision       Int
  occurredAt     DateTime     @default(now())
  payload        String
  pushedAt       DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([entityType, entityId, revision])
}

model SyncCursor {
  id             String       @id @default(cuid())
  organizationId String
  deviceId       String
  backend        String
  lastEventId    String?
  lastOccurredAt DateTime?
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device         Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, deviceId, backend])
}

model KnowledgeSpace {
  id               String                   @id @default(cuid())
  organizationId   String                   @default("local-org")
  scope            String
  ownerAgentId     String?
  repoPath         String?
  repoUrl          String?
  defaultBranch    String                   @default("main")
  credentialRef    String?
  activeSnapshotId String?
  readPolicy       String
  writePolicy      String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bindings         KnowledgeBinding[]
  snapshots        KnowledgeSnapshot[]
  changeRequests   KnowledgeChangeRequest[]

  @@unique([id, organizationId])
  @@index([organizationId, scope, updatedAt])
  @@index([organizationId, ownerAgentId, updatedAt])
}

model KnowledgeBinding {
  id             String         @id @default(cuid())
  organizationId String         @default("local-org")
  workspaceId    String
  agentId        String?
  spaceId        String
  mountPath      String
  access         String         @default("read")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space          KnowledgeSpace @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, workspaceId, agentId, spaceId, mountPath])
  @@index([organizationId, workspaceId, updatedAt])
  @@index([organizationId, agentId, updatedAt])
  @@index([spaceId, updatedAt])
}

model KnowledgeSnapshot {
  id              String                 @id @default(cuid())
  organizationId  String                 @default("local-org")
  spaceId         String
  changeRequestId String
  commitSha       String
  indexVersion    String
  artifactPath    String
  artifactSha256  String
  readyAt         DateTime
  createdAt       DateTime               @default(now())
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space           KnowledgeSpace         @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  changeRequest   KnowledgeChangeRequest @relation(fields: [changeRequestId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([spaceId, commitSha, indexVersion])
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([spaceId, createdAt])
  @@index([changeRequestId, createdAt])
}

model KnowledgeChangeRequest {
  id               String                    @id @default(cuid())
  organizationId   String                    @default("local-org")
  jobId            String
  attemptId        String
  spaceId          String
  baseCommit       String
  headCommit       String
  branchName       String
  status           String                    @default("pending_review")
  diffSummary      String                    @default("")
  diffMetadataJson String                    @default("{}")
  reviewerId       String?
  reviewNote       String?
  reviewedAt       DateTime?
  mergedCommit     String?
  mergedAt         DateTime?
  revision         Int                       @default(1)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space            KnowledgeSpace            @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  snapshots        KnowledgeSnapshot[]
  mergeOperations  KnowledgeMergeOperation[]

  @@unique([id, organizationId])
  @@unique([attemptId, spaceId, headCommit])
  @@index([organizationId, status, updatedAt])
  @@index([jobId, createdAt])
  @@index([attemptId, createdAt])
  @@index([spaceId, status, updatedAt])
}

model KnowledgeMergeOperation {
  id                 String                 @id @default(cuid())
  organizationId     String                 @default("local-org")
  changeRequestId    String
  requestedById      String
  expectedRevision   Int
  expectedBaseCommit String
  expectedHeadCommit String
  indexVersion       String
  status             String                 @default("queued")
  attemptCount       Int                    @default(0)
  leaseOwnerId       String?
  leaseExpiresAt     DateTime?
  mergedCommit       String?
  snapshotId         String?
  errorCode          String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changeRequest      KnowledgeChangeRequest @relation(fields: [changeRequestId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([changeRequestId, expectedRevision])
  @@index([organizationId, status, updatedAt])
  @@index([changeRequestId, createdAt])
}
